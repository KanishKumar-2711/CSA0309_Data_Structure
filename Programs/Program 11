#include <stdio.h>

#define MAX 100

int stack[MAX];
int top = -1;

void push(int value)
{
    if (top == MAX - 1)
        printf("Stack Overflow\n");
    else
        stack[++top] = value;
}

void pop()
{
    if (top == -1)
        printf("Stack Underflow\n");
    else
        printf("%d\n", stack[top--]);
}

void peek()
{
    if (top == -1)
        printf("Stack is empty\n");
    else
        printf("%d\n", stack[top]);
}

int main()
{
    int choice, value;

    scanf("%d", &choice);

    switch (choice)
    {
        case 1:
            scanf("%d", &value);
            push(value);
            break;

        case 2:
            pop();
            break;

        case 3:
            peek();
            break;
    }

    return 0;
}
