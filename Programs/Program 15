#include <stdio.h>

#define SIZE 10

int hashTable[SIZE];

void initialize()
{
    int i;

    for (i = 0; i < SIZE; i++)
        hashTable[i] = -1;
}

void insert(int key)
{
    int index = key % SIZE;
    int i;

    for (i = 0; i < SIZE; i++)
    {
        if (hashTable[index] == -1)
        {
            hashTable[index] = key;
            return;
        }

        index = (index + 1) % SIZE;
    }

    printf("Hash table is full\n");
}

void display()
{
    int i;

    for (i = 0; i < SIZE; i++)
        printf("%d : %d\n", i, hashTable[i]);
}

int main()
{
    int n, key, i;

    initialize();

    scanf("%d", &n);

    for (i = 0; i < n; i++)
    {
        scanf("%d", &key);
        insert(key);
    }

    display();

    return 0;
}
