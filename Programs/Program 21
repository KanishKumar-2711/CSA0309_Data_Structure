#include <stdio.h>

int main()
{
    int graph[20][20], visited[20] = {0};
    int queue[20], front = 0, rear = 0;
    int n, i, j, start;

    scanf("%d", &n);

    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    scanf("%d", &start);

    visited[start] = 1;
    queue[rear++] = start;

    while (front < rear)
    {
        start = queue[front++];
        printf("%d ", start);

        for (i = 0; i < n; i++)
        {
            if (graph[start][i] == 1 && !visited[i])
            {
                visited[i] = 1;
                queue[rear++] = i;
            }
        }
    }

    return 0;
}
