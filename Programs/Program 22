#include <stdio.h>

int graph[20][20];
int visited[20];
int n;

void dfs(int vertex)
{
    int i;

    visited[vertex] = 1;
    printf("%d ", vertex);

    for (i = 0; i < n; i++)
    {
        if (graph[vertex][i] == 1 && !visited[i])
            dfs(i);
    }
}

int main()
{
    int i, j, start;

    scanf("%d", &n);

    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    scanf("%d", &start);

    dfs(start);

    return 0;
}
